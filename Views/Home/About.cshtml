@{
    ViewData["Title"] = "About XYZ";
}

<div class="row">
    <div class="col-sm-12">
        <h2 class="bg-success text-white p-3 mb-4 rounded">
            XYZ Detective Agency
        </h2>
    </div>
</div>

<div class="row">
    <div class="col-sm-7">
        <p>
            Our agency was founded in 1960 by Scooby and Scrappy Doo.
            The agency expanded in the 1980's across the United States and is now the top
            agency in the midwest.
        </p>

        <p>
            In 2000, the agency expanded to Europe and in 2020, the agency will also be
            in Africa and Australia.
        </p>
    </div>

    <div class="col-sm-5">
        <img src="~/Images/scooby-and-scrappy.jpg"
             alt="Scooby and Scrappy"
             class="img-fluid rounded-circle" />
    </div>
</div>